{
  "name": "vision-solution-tms-sys",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "check": "npm run format:check && npm run lint && npm run test && npm run build && npm run check:bundle",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "test:db": "node scripts/test-database.mjs",
    "dev:connected": "vite --mode connected",
    "build:connected": "tsc -b && vite build --mode connected --outDir dist-connected",
    "test:auth": "node --experimental-strip-types --test tests/auth/local-auth.test.ts",
    "test:security": "node --experimental-strip-types --test tests/security/accounts.test.mjs",
    "accounts:local": "node --experimental-strip-types scripts/local-accounts.ts",
    "auth:rotate-preview": "node --experimental-strip-types scripts/rotate-local-preview.ts",
    "auth:fixture": "node --experimental-strip-types scripts/local-auth-preview.ts",
    "check:bundle": "node scripts/check-client-bundle.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cairo": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "supabase": "2.122.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "npm": ">=10",
    "node": ">=22.12.0"
  }
}
